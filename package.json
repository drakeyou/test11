{
  "name": "ggbet-cs-live-monitor",
  "version": "1.0.0",
  "description": "Live scores and odds monitor for gg.bet (CS2, LoL, Dota 2, Valorant, tennis)",
  "type": "module",
  "bin": {
    "cs-monitor": "src/monitor.mjs"
  },
  "scripts": {
    "discover": "node src/monitor.mjs --discover",
    "watch": "node src/monitor.mjs",
    "inspect": "node src/inspect.mjs",
    "test": "node src/parse.test.mjs && node src/changes.test.mjs"
  },
  "dependencies": {
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
